# Copy to `.env` and fill in. `.env` is never committed.
# Anything set here overrides config/settings.yaml. Blank values are ignored.

# Workspace URL, for example https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=
# Name of the CLI profile, if you signed in with
# `databricks auth login --host <url> --profile <name>`. This is the recommended way.
DATABRICKS_CONFIG_PROFILE=
# Optional. Leave blank when a CLI profile is used.
# Read only by the Databricks SDK, never by this project's code.
DATABRICKS_TOKEN=

CATALOG=frontline
LLM_ENDPOINT=databricks-gpt-oss-120b
JUDGE_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
EMBEDDING_ENDPOINT=databricks-gte-large-en
VS_ENDPOINT=frontline-vs
VS_INDEX=frontline.gold.kb_chunks_index
SQL_WAREHOUSE_ID=
MLFLOW_EXPERIMENT=/Users/<me>/frontline-copilot
